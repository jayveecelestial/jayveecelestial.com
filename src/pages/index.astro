---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/avatar.webp';
import { STATIONS } from '../game/world';
import { QUEST } from '../game/quest';
import { email, links, experience, certs, skills, stats, offDuty, description } from '../data/profile';

const site = 'https://jayveecelestial.com/';

// Tiny 8x8 pixel icons; '#' = filled pixel. Drawn as one crisp path each.
const icons: Record<string, string[]> = {
  about: ['..####..', '.######.', '.######.', '..####..', '...##...', '.######.', '########', '########'],
  work: ['########', '#......#', '#.####.#', '########', '#......#', '#.####.#', '########', '........'],
  certs: ['########', '#.####.#', '#.####.#', '.######.', '..####..', '...##...', '...##...', '..####..'],
  tools: ['..####..', '..#..#..', '..####..', '...##...', '...##...', '...##...', '..####..', '..####..'],
  'off-duty': ['########', '#......#', '#.####.#', '#.####.#', '#......#', '########', '..####..', '.######.'],
  contact: ['########', '##....##', '#.#..#.#', '#..##..#', '#......#', '#......#', '########', '........'],
};
const iconPath = (rows: string[]) =>
  rows.flatMap((r, y) => [...r].map((c, x) => (c === '#' ? `M${x} ${y}h1v1h-1z` : ''))).join('');

// Visible tracker text per quest id (QUEST_TEXT is screen-reader announcement text).
const questLabels: Record<(typeof QUEST)[number], string> = {
  work: 'Read the Quest log',
  certs: 'Inspect the trophies',
  contact: 'Check the mailbox',
};
// Break station labels after the dot so the tail never wraps alone.
const splitLabel = (label: string): [string, string | undefined] => {
  const [head, ...tail] = label.split(' · ');
  return [head, tail.length ? tail.join(' · ') : undefined];
};

const twitch = offDuty.links[0];
---

<Base title="Jayvee Celestial" description={description} skip>
  <Fragment slot="head">
    <meta property="og:title" content="Jayvee Celestial" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:image" content="https://jayveecelestial.com/og-night-shift.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jayvee Celestial, Senior DevOps Engineer — pixel-art night shift room" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jayvee Celestial" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://jayveecelestial.com/og-night-shift.png" />
    <link rel="canonical" href={site} />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Jayvee Celestial",
      "jobTitle": "Senior DevOps Engineer",
      "url": "https://jayveecelestial.com/",
      "sameAs": [
        "https://www.linkedin.com/in/jayveecelestial/",
        "https://github.com/jayveecelestial",
        "https://www.credly.com/users/jayvee-celestial/badges"
      ]
    }
    </script>
  </Fragment>

  <div id="hud">
    <a id="mode-toggle" class="btn btn-small" href="?view=plain#about">Plain view</a>
    <button id="help" class="btn btn-small" type="button" aria-label="How to play">?</button>
  </div>

  <div id="stage-wrap">
    <canvas id="stage" width="384" height="216" aria-hidden="true"></canvas>
  </div>

  <div id="touchpad" aria-hidden="true">
    <button type="button" tabindex="-1" data-move="left">◀</button>
    <button type="button" tabindex="-1" data-act>Open</button>
    <button type="button" tabindex="-1" data-move="right">▶</button>
  </div>

  <nav id="stations" aria-label="Sections">
    {STATIONS.map(s => (
      <a class="btn station" href={`#${s.id}`} data-station={s.id}>
        <svg class="icon" viewBox="0 0 8 8" width="24" height="24" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
          <path d={iconPath(icons[s.id])} fill="currentColor" />
        </svg>
        <span>{splitLabel(s.label)[0]}{splitLabel(s.label)[1] && <> · <span class="nowrap">{splitLabel(s.label)[1]}</span></>}</span>
      </a>
    ))}
  </nav>

  <div id="tutorial" class="px-panel" role="region" aria-label="How to play" hidden>
    <h2>How to play</h2>
    <p data-tutorial-keys>
      Walk with the left and right arrow keys or A and D. Jump with Up, W or Space.
      Stand near a glowing object and press Enter or E to open it. Esc closes.
    </p>
    <p data-tutorial-touch>
      Tap an object to walk there and open it, or use the buttons below the room.
    </p>
    <button type="button" class="btn" data-tutorial-close>Got it</button>
  </div>

  <aside id="quest" hidden aria-label="Quest">
    <button type="button" id="quest-toggle" aria-expanded="true" aria-controls="quest-list">
      <span class="q-title">Quest</span> <span id="quest-count">0/3</span>
      <span class="q-complete">Quest done</span>
    </button>
    <ol id="quest-list">
      {QUEST.map(id => (
        <li data-quest={id}><span class="q-box" aria-hidden="true"></span><span>{questLabels[id]}</span> <span class="q-state sr-only">to do</span></li>
      ))}
    </ol>
    <button type="button" class="btn btn-small btn-alt q-reset" data-quest-reset>Play again</button>
  </aside>

  <dialog id="quest-done" aria-labelledby="quest-done-title">
    <span class="confetti" aria-hidden="true"></span>
    <h2 id="quest-done-title" tabindex="-1">Quest complete!</h2>
    <p>Thanks for touring the room. Want the full story?</p>
    <div class="q-actions">
      <a class="btn" href="/Jayvee-Celestial-CV.pdf" download>Download CV</a>
      <a class="btn btn-alt email-link" href="#contact" data-u={email.user} data-d={email.domain}>Email me</a>
    </div>
    <div class="q-actions">
      <button type="button" class="btn btn-small btn-alt" data-quest-close>Close</button>
      <button type="button" class="btn btn-small btn-alt" data-quest-reset>Play again</button>
    </div>
  </dialog>

  <div id="sections">
    <section id="about" class="px-panel sec">
      <p class="kicker">Player 1</p>
      <h2 id="about-title" tabindex="-1">About</h2>
      <div class="card">
        <Image src={portrait} alt="Photo of Jayvee Celestial" width={192} height={192} format="webp" class="portrait" loading="eager" />
        <div class="card-body">
          <h1>Jayvee Celestial</h1>
          <p class="role">Senior DevOps Engineer</p>
        </div>
      </div>
      <ul class="stats">
        {stats.map(s => (
          <li class="tile"><strong>{s.value}</strong><span>{s.label}</span></li>
        ))}
      </ul>
      <p class="lede">
        I build and run OpenShift and Kubernetes platforms. Right now that's
        release automation at <strong>eMcREY</strong> in Riyadh; before that,
        three years at <strong>IBM</strong> keeping banking platforms deployable
        and governed across clusters.
      </p>
      <p>
        I take on remote DevOps work, from a single pipeline to a whole
        platform.
      </p>
      <ul class="links">
        <li><a class="btn email-link" href="#contact" data-u={email.user} data-d={email.domain}>Email</a></li>
        {links.map(l => (
          <li><a class="btn" href={l.href} download={l.download ? "" : undefined} target={l.download ? undefined : "_blank"} rel="noopener noreferrer">{l.label}</a></li>
        ))}
      </ul>
    </section>

    <section id="work" class="px-panel sec">
      <p class="kicker">Quest log</p>
      <h2 id="work-title" tabindex="-1">Work</h2>
      <div class="body">
        {experience.map(e => (
          <article class="job">
            <div class="row">
              <h3>{e.role}, <span class="muted">{e.company}</span></h3>
              <span class="meta">{e.period}</span>
            </div>
            <ul>
              {e.bullets.map(b => <li>{b}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="certs" class="px-panel sec">
      <p class="kicker">Trophies · <span class="nowrap">{certs.length} certs</span></p>
      <h2 id="certs-title" tabindex="-1">Certifications</h2>
      <div class="body">
        <ul class="certs">
          {certs.map(c => (
            <li>
              <span>{c.name}{c.code && <span class="meta code">{c.code}</span>}</span>
              <span class="meta">{c.date}</span>
            </li>
          ))}
        </ul>
        <p class="more"><a href="https://www.credly.com/users/jayvee-celestial/badges" target="_blank" rel="noopener noreferrer">All badges on Credly</a></p>
      </div>
    </section>

    <section id="tools" class="px-panel sec">
      <p class="kicker">Inventory</p>
      <h2 id="tools-title" tabindex="-1">Tools</h2>
      <div class="body">
        <dl class="skills">
          {skills.map(s => (
            <>
              <dt>{s.label}</dt>
              <dd>{s.items}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>

    <section id="off-duty" class="px-panel sec">
      <p class="kicker">Side quest</p>
      <h2 id="off-duty-title" tabindex="-1">Off duty</h2>
      <div class="body">
        <p>{offDuty.text}</p>
        <p><a class="btn" href={twitch.href} target="_blank" rel="noopener noreferrer">Watch on Twitch</a> <span class="meta">{twitch.handle}</span></p>
      </div>
    </section>

    <section id="contact" class="px-panel sec">
      <p class="kicker">Mailbox</p>
      <h2 id="contact-title" tabindex="-1">Contact</h2>
      <div class="body">
        <p>
          Got a deployment that's stuck, or a platform that needs an owner?
          Write to <a href="#contact" class="email-link" data-u={email.user} data-d={email.domain}>{email.user} at gmail</a>.
          I usually reply within a day.
        </p>
      </div>
    </section>
  </div>

  <dialog id="panel">
    <button type="button" class="btn btn-small close" data-close aria-label="Close"><span class="x" aria-hidden="true">X</span><span class="lbl" aria-hidden="true">Close</span></button>
  </dialog>

  <div id="live" class="sr-only" aria-live="polite"></div>

  <script>
    import '../game/boot';

    // Build the address on click to keep it out of the HTML for scrapers.
    document.querySelectorAll<HTMLAnchorElement>('.email-link').forEach(a => {
      a.addEventListener('click', e => {
        e.preventDefault();
        window.location.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
      });
    });
  </script>
</Base>
