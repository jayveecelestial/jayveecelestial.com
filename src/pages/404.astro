---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Jayvee Celestial" description="This page doesn't exist.">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <header class="intro">
    <p class="meta">404</p>
    <h1>Nothing here.</h1>
    <p class="lede">
      This page doesn't exist, or it moved when the site was redesigned.
    </p>
    <ul class="links">
      <li><a href="/">Back to the homepage</a></li>
    </ul>
  </header>
</Base>
