---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/hero.png';
---

<Base title="Page not found · Jayvee Celestial" description="This page doesn't exist.">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="Page not found · Jayvee Celestial" />
    <meta property="og:description" content="This page doesn't exist." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jayveecelestial.com/" />
    <meta property="og:image" content="https://jayveecelestial.com/og-night-shift.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jayvee Celestial, Senior DevOps Engineer — pixel-art night shift room" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://jayveecelestial.com/og-night-shift.png" />
  </Fragment>

  <section class="px-panel lost">
    <Image src={hero} alt="" width={hero.width * 4} height={hero.height * 4} format="png" class="hero" />
    <p class="kicker">404 · Wrong room</p>
    <h1>Nothing here.</h1>
    <p class="lede">
      This page doesn't exist, or it moved when the site was redesigned.
    </p>
    <p><a class="btn" href="/">Back to the homepage</a></p>
  </section>
</Base>
