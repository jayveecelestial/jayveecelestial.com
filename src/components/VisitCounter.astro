---
// One-line visitor strip. Rendered only when the counter is enabled; stays
// invisible (but keeps its height, so no layout shift) until numbers arrive.
---

<p id="visits" class="visits" role="group" title="Anonymous count · no personal data stored">
  <span class="lbl wide">You're </span><span class="lbl">Visitor #</span><b id="visit-n"></b>
  <span class="sep" aria-hidden="true">·</span>
  <span class="lbl" id="visit-pre"></span><b id="visit-visits"></b><span class="lbl" id="visit-post"></span>
  <span class="gap" aria-hidden="true">|</span>
  <b id="visit-total"></b><span class="lbl" id="visit-total-label"></span>
  <span class="sep" aria-hidden="true">·</span>
  <b id="visit-total-visits"></b><span class="lbl" id="visit-total-visits-label"></span><span class="lbl wide"> total</span>
</p>

<script>
  import '../scripts/visit-counter';
</script>

<style>
  .visits {
    margin: 0;
    height: 1.75rem;
    line-height: 1.75rem;
    flex: none;
    background: var(--px-city);
    border-bottom: 4px solid var(--edge);
    font: 600 0.8rem/1.75rem var(--display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    visibility: hidden;
  }
  .visits[data-ready] { visibility: visible; }
  .lbl, .sep, .gap { color: var(--muted); }
  .sep { margin: 0 0.35em; }
  .gap { margin: 0 0.9em; opacity: 0.6; }
  b { color: var(--accent); font-weight: 600; }
  @media (max-width: 600px) {
    .wide { display: none; }
  }
  @media (max-width: 470px) {
    .visits { font-size: 0.62rem; letter-spacing: 0; }
    .sep { margin: 0 0.25em; }
    .gap { margin: 0 0.5em; }
  }
  @media (max-width: 340px) {
    .sep { margin: 0 0.15em; }
    .gap { margin: 0 0.3em; }
  }
</style>
