---
// Shared page frame: head, fonts, styles, skip link, footer, analytics.
// Fonts are bundled and served from this site (Latin subset only).
import '@fontsource/red-hat-display/latin-600.css';
import '@fontsource/red-hat-display/latin-700.css';
import '@fontsource/red-hat-text/latin-400.css';
import '@fontsource/red-hat-text/latin-500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  skip?: boolean;
}
const { title, description, skip = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#1A1423" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <slot name="head" />
  <noscript><style>#mode-toggle { display: none; }</style></noscript>
</head>
<body>
  {skip && <a class="skip" href="/?view=plain#about">Skip to plain CV</a>}
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <span>© <span id="year">{new Date().getFullYear()}</span> Jayvee Celestial</span>
    <span aria-hidden="true">·</span>
    <span>Riyadh</span>
  </footer>

  <script>
    // Refresh the footer year in case the page was built in an earlier year.
    const year = document.getElementById('year');
    if (year) year.textContent = String(new Date().getFullYear());
  </script>

  <script>
    import { inject } from '@vercel/analytics';
    inject();
  </script>
</body>
</html>
